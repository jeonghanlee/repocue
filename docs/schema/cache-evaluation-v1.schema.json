{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repocue.local/schema/cache-evaluation-v1.schema.json",
  "title": "cache-evaluation",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/summary"
    },
    {
      "$ref": "#/$defs/assessments"
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "repocue/cache-evaluation-1"
        },
        "kind": {
          "const": "preparation"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "preparing",
            "prepared",
            "failed"
          ]
        },
        "benchmark_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "cue_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer_schema_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "anyOf": [
            {
              "$ref": "https://repocue.local/schema/task-evaluation-v1.schema.json#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec": {
          "$ref": "https://repocue.local/schema/cache-benchmark-v1.schema.json"
        },
        "preparation": {
          "type": "array",
          "items": {
            "$ref": "https://repocue.local/schema/task-evaluation-v1.schema.json#/$defs/process"
          }
        },
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "directory",
        "repository",
        "created_at",
        "status",
        "benchmark_digest",
        "cue_digest",
        "answer_schema_digest",
        "basis",
        "spec",
        "preparation",
        "requests",
        "error"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "repocue/cache-evaluation-1"
        },
        "kind": {
          "const": "summary"
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "arm": {
                "enum": [
                  "baseline",
                  "cache",
                  "probe"
                ]
              },
              "condition": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "integrity": {
                "type": "boolean"
              },
              "delivery": {
                "type": "boolean"
              },
              "correctness": {
                "$ref": "https://repocue.local/schema/task-evaluation-v1.schema.json#/$defs/outcome"
              },
              "compliance": {
                "$ref": "https://repocue.local/schema/task-evaluation-v1.schema.json#/$defs/outcome"
              },
              "usage": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "ordinary_input": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cache_write": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cache_write_5m": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cache_write_1h": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "cache_read": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "output": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "total_input": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "ordinary_input",
                      "cache_write",
                      "cache_write_5m",
                      "cache_write_1h",
                      "cache_read",
                      "output",
                      "total_input"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "estimated_usd": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "duration_ms": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cache_activity": {
                "enum": [
                  "reuse",
                  "creation",
                  "creation-and-reuse",
                  "none-observed",
                  "not_observed"
                ]
              },
              "answer_digest": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "step_id",
              "arm",
              "condition",
              "status",
              "integrity",
              "delivery",
              "correctness",
              "compliance",
              "usage",
              "estimated_usd",
              "duration_ms",
              "cache_activity",
              "answer_digest",
              "error"
            ],
            "additionalProperties": false
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pair_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,47}$"
              },
              "baseline_usd": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cache_usd": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "difference_usd": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "initial_request_usd": {"type": ["string", "null"]},
              "subsequent_requests_usd": {"type": ["string", "null"]},
              "observed_reuse_count": {"type": ["integer", "null"], "minimum": 0, "maximum": 32},
              "verdict": {
                "$ref": "https://repocue.local/schema/task-evaluation-v1.schema.json#/$defs/outcome"
              }
            },
            "required": [
              "pair_id",
              "baseline_usd",
              "cache_usd",
              "difference_usd",
              "initial_request_usd",
              "subsequent_requests_usd",
              "observed_reuse_count",
              "verdict"
            ],
            "additionalProperties": false
          }
        },
        "total_estimated_usd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "not_observed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "attempts",
        "pairs",
        "total_estimated_usd",
        "not_observed",
        "errors"
      ],
      "additionalProperties": false
    },
    "assessments": {
      "type": "object",
      "properties": {
        "schema_version": {
