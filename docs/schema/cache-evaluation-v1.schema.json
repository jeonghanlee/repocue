                  "type": "string"
                },
                "uniqueItems": true
              },
              "assessor": {
                "type": "string",
                "minLength": 1
              },
              "rubric": {
                "type": "string",
                "minLength": 1
              },
              "correct": {
                "type": "boolean"
              },
              "compliant": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "step_id",
              "benchmark_digest",
              "request_digest",
              "response_digest",
              "answer_digest",
              "basis_fingerprint",
              "source_ids",
              "assessor",
              "rubric",
              "correct",
              "compliant"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "assessments"
      ],
      "additionalProperties": false
    },
