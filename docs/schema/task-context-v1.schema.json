{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repocue.local/schema/task-context-v1.schema.json",
  "title": "RepoCue task-context-v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "repocue/task-context-1"
    },
    "task_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "instruction",
              "design",
              "verification"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "task_kinds": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "path_prefixes": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\\\:]+$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\\\:]+$"
              },
              "content_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "lines": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "start": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "path",
              "content_digest",
              "lines"
            ],
            "additionalProperties": false
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\\\:]+$"
                },
                "content_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "lines": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "path",
                "content_digest",
                "lines"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "required",
          "task_kinds",
          "path_prefixes",
          "source",
          "checks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_kinds",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\\\:]+$"
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lines": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "content_digest",
        "lines"
      ],
      "additionalProperties": false
    }
  }
}
